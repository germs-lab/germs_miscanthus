{"version":3,"schema_version":1,"doc":{"type":"doc","attrs":{"table_of_contents":{"enabled":true,"allowedLevels":[1,2,3]}},"content":[{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"7397773747"}}],"text":"The \"ps_16S_LAMP.rds\" contains the metadata and microbiome dataset from DADA2 of DNA and RNA. The DNA and RNA dataset contains the microbial communities of corn and miscanthus, and contains 696 DNA and 480 RNA data."}]}]},"savepoint_metadata":{"savepointFileId":null,"savepointsInfo":{},"shouldCreateSavepointBeforeApplyingNextVersion":false,"authorsSinceLastSavepoint":{"7397773747":true},"allAuthorNames":{"7397773747":"Jihoon Yang"}},"last_edit_timestamp":1680036318188}